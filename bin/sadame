#!/bin/sh
# Runs sadame from a source checkout, building it first when needed. Release
# builds are the single binary build/sadame; this script only locates it.
root=$(cd "$(dirname "$0")/.." && pwd)
if [ ! -x "$root/build/sadame" ]; then
  make -C "$root" build/sadame >&2 || exit 2
fi
exec "$root/build/sadame" "$@"
